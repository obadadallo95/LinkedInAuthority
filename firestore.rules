rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all security net
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // User must only access their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /agents/{agentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /actions/{actionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /auditLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Settings Schema Validation
      match /settings/{document=**} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          // Ensure strings if present
          && (!('githubUsername' in request.resource.data) || request.resource.data.githubUsername is string)
          && (!('githubToken' in request.resource.data) || request.resource.data.githubToken is string)
          && (!('linkedinToken' in request.resource.data) || request.resource.data.linkedinToken is string);
      }

      // Posts Schema Validation
      match /posts/{postId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          // Prevent arbitrary field types
          && (!('text' in request.resource.data) || request.resource.data.text is string)
          && (!('status' in request.resource.data) || request.resource.data.status in ['draft', 'published', 'scheduled', 'failed', 'template'])
          && (!('repoName' in request.resource.data) || request.resource.data.repoName is string)
          // Ensure nested map is a map
          && (!('cardConfig' in request.resource.data) || request.resource.data.cardConfig is map);
      }
      
      match /logs/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
