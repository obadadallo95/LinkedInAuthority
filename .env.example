# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Development-only placeholder; replace with a random value in every environment.
ANALYSIS_SIGNING_SECRET="replace_with_local_random_signing_secret"

# Required for server-side AES-256-GCM encryption of GitHub credentials.
# Generate 32 random bytes and base64-encode them; never commit the value.
GITHUB_CREDENTIAL_ENCRYPTION_KEY="replace_with_base64_32_byte_key"

# Required for local calls to /api/cron/process-weekly. There is no fallback.
CRON_SECRET="replace_with_local_random_cron_secret"

# Optional, off by default to avoid telemetry writes/cost during local work.
# When enabled, stores only daily per-user event counters without content.
PRODUCT_TELEMETRY_ENABLED="false"
# Optional client flag for the authenticated draft-event bridge.
VITE_PRODUCT_TELEMETRY_ENABLED="false"
